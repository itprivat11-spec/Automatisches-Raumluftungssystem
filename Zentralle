//Zentralle
#include <WiFi.h>
#include <WebServer.h>

const char* ssid = "SFZ-Singen-Gast";
const char* password = "SFZ_2021";

WebServer server(80);

float sollTemp = 25.0;
int sollCo2 = 800;
int sollHum = 50;

struct RaumDaten {
  float temp;
  int co2;
  float hum;
  unsigned long zuletzt;  
  bool vorhanden;          
};
RaumDaten raeume[4];

void meldung() {
  if (!server.hasArg("raum") || !server.hasArg("temp") ||
      !server.hasArg("co2") || !server.hasArg("hum")) {
    server.send(400, "text/plain", "Parameter fehlen");
    return;
  }

  int raum = server.arg("raum").toInt();
  if (raum < 1 || raum > 3) {
    server.send(400, "text/plain", "Raum ungueltig");
    return;
  }

  raeume[raum].temp = server.arg("temp").toFloat();
  raeume[raum].co2 = server.arg("co2").toInt();
  raeume[raum].hum = server.arg("hum").toFloat();
  raeume[raum].zuletzt = millis();
  raeume[raum].vorhanden = true;

  Serial.printf("Raum %d: %.1f C, %d ppm, %.1f %%\n",
                raum, raeume[raum].temp, raeume[raum].co2, raeume[raum].hum);

  String antwort = String(sollTemp, 1) + ";" + String(sollCo2) + ";" + String(sollHum);
  server.send(200, "text/plain", antwort);
}

void sollSetzen() {
  if (server.hasArg("temp")) sollTemp = constrain(server.arg("temp").toFloat(), 15.0, 30.0);
  if (server.hasArg("co2"))  sollCo2  = constrain(server.arg("co2").toInt(), 400, 2000);
  if (server.hasArg("hum"))  sollHum  = constrain(server.arg("hum").toInt(), 20, 80);

  Serial.printf("Neue Sollwerte: %.1f C, %d ppm, %d %%\n", sollTemp, sollCo2, sollHum);

  server.sendHeader("Location", "/"); 
  server.send(303);
}

void startseite() {
  String html = "<!DOCTYPE html><html><head>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
  html += "<meta http-equiv='refresh' content='10'>";   // alle 10 s neu laden
  html += "<title>Raumluft</title></head><body style='font-family:sans-serif'>";
  html += "<h1>Raumluft</h1>";

  for (int i = 1; i <= 3; i++) {
    html += "<h3>Raum " + String(i) + "</h3>";
    bool online = raeume[i].vorhanden && (millis() - raeume[i].zuletzt < 30000);
    if (online) {
      html += "<p>" + String(raeume[i].temp, 1) + " &deg;C, " +
              String(raeume[i].co2) + " ppm, " +
              String(raeume[i].hum, 1) + " %</p>";
    } else {
      html += "<p>offline</p>";
    }
  }

  html += "<h2>Sollwerte</h2>";
  html += "<form action='/soll' method='get'>";
  html += "Temperatur: <input type='number' step='0.5' name='temp' value='" + String(sollTemp, 1) + "'> &deg;C<br>";
  html += "CO2: <input type='number' name='co2' value='" + String(sollCo2) + "'> ppm<br>";
  html += "Feuchte: <input type='number' name='hum' value='" + String(sollHum) + "'> %<br>";
  html += "<button type='submit'>Speichern</button>";
  html += "</form></body></html>";

  server.send(200, "text/html", html);
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.print("Verbinde");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("IP der Zentrale: ");
  Serial.println(WiFi.localIP());   // diese IP kommt in den Raumknoten-Code

  server.on("/", startseite);
  server.on("/soll", sollSetzen);
  server.on("/api/meldung", meldung);
  server.begin();
}

void loop() {
  server.handleClient();
}
void loop() {
  server.handleClient();
}
